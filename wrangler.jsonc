{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "note",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "kv_namespaces": [
    { "binding": "CLOUD_EDITOR_KV", "id": "bcb723095bbf48c99540fce7183bce74" }
  ],
  "vars": { "PROXY_ALLOWED_HOSTS": "" },
  "ratelimits": [
    { "name": "LOGIN_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
